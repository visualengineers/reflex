{
  "name": "@reflex/emulator",
  "author": "Mathias Müller",
  "description": "Emulator for depth sensing input for developing applications for Elastic Displays using the ReFlex framework",
  "version": "0.9.10",
  "main": "main.js",
  "scripts": {
    "ng": "ng",
    "start": "ng serve reflex-emulator --port 4300",
    "build": "ng build reflex-emulator",
    "test": "ng test reflex-emulator",
    "test-ci": "ng test reflex-emulator --no-watch --code-coverage --browsers=ChromeHeadless",
    "lint": "ng lint reflex-emulator",
    "e2e": "ng e2e reflex-emulator",
    "electron": "ng build reflex-emulator --base-href ./ && electron .",
    "build:electron-win": "node ../../scripts/build-electron.cjs emulator win x64",
    "build:electron-osx": "node ../../scripts/build-electron.cjs emulator osx x64",
    "build:electron-osx-arm64": "node ../../scripts/build-electron.cjs emulator osx arm64",
    "build:electron-linux": "node ../../scripts/build-electron.cjs emulator linux x64",
    "build:electron-linux-arm64": "node ../../scripts/build-electron.cjs emulator linux arm64"
  },
  "build": {
    "appId": "reflex.emulator",
    "productName": "ReFlex Emulator",
    "copyright": "Copyright © 2023",
    "buildVersion": "0.9.10",
    "electronVersion": "23.2.4",
    "win": {
      "icon": "dist/browser/assets/icon/app_icon_inverted.ico"
    },
    "mac": {
      "icon": "dist/browser/assets/icon/app_icon_inverted.png"
    },
    "files": [
      "main.js",
      "dist/**/*",
      "package.json"
    ],
    "directories": {
      "output": "release",
      "buildResources": "assets"
    },
    "npmRebuild": false,
    "linux": {
      "target": [
        "AppImage"
      ],
      "icon": "dist/browser/assets/icon/app_icon_inverted.png"
    }
  },
  "private": true,
  "repository": {
    "type": "git",
    "url": "git+https://github.com/visualengineers/reflex.git"
  },
  "keywords": [
    "elastic-displays",
    "shape-changing-interfaces",
    "electron",
    "developer-tool",
    "emulator"
  ],
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/visualengineers/reflex/issues"
  },
  "homepage": "https://github.com/visualengineers/reflex#readme",
  "browserslist": [
    "defaults"
  ],
  "dependencies": {
    "@fortawesome/angular-fontawesome": "^4.0.0",
    "@fortawesome/fontawesome-free": "^6.7.2",
    "@fortawesome/fontawesome-svg-core": "^6.7.2",
    "@fortawesome/free-brands-svg-icons": "^6.7.2",
    "@fortawesome/free-regular-svg-icons": "^6.7.2",
    "@fortawesome/free-solid-svg-icons": "^6.7.2",
    "@reflex/shared-types": "file:../../packages/reflex-shared-types",
    "bootstrap": "^5.3.3"
  }
}
