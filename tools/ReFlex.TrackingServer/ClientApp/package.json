{
  "name": "@reflex/trackingserver",
  "version": "0.9.10",
  "description": "Platform-independent server application using ASP.NET Core as backend and Angular as frontend.",
  "main": "app.js",
  "scripts": {
    "ng": "ng",
    "start:windows": "ng serve TrackingServer --ssl --ssl-cert %APPDATA%\\ASP.NET\\https\\%npm_package_name%.pem --ssl-key %APPDATA%\\ASP.NET\\https\\%npm_package_name%.key",
    "start:default": "ng serve TrackingServer --ssl --ssl-cert $HOME/.aspnet/https/${npm_package_name}.pem --ssl-key $HOME/.aspnet/https/${npm_package_name}.key",
    "prestart": "node aspnetcore-https",
    "start": "ng serve TrackingServer -c development",
    "start:electron": "electron .",
    "build": "ng build TrackingServer --base-href ./",
    "build:electron-win": "node ../../../scripts/build-electron.cjs server win x64",
    "build:electron-osx": "node ../../../scripts/build-electron.cjs server osx x64",
    "build:electron-osx-arm64": "node ../../../scripts/build-electron.cjs server osx arm64",
    "build:electron-linux": "node ../../../scripts/build-electron.cjs server linux x64",
    "build:electron-linux-arm64": "node ../../../scripts/build-electron.cjs server linux arm64",
    "test": "ng test TrackingServer --coverage",
    "test-ci": "ng test TrackingServer --no-watch --coverage",
    "lint": "eslint .",
    "lint-fix": "eslint . --fix",
    "e2e": "ng e2e TrackingServer",
    "serve:ssr:TrackingServer": "node dist/server/server.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/visualengineers/reflex.git"
  },
  "author": "Mathias M\u00fcller",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/visualengineers/reflex/issues"
  },
  "homepage": "https://github.com/visualengineers/reflex#readme",
  "keywords": [
    "electron",
    "sdk",
    "dotnet-core",
    "shape-changing-interfaces",
    "elastic-displays"
  ],
  "browserslist": [
    "defaults"
  ],
  "private": true,
  "dependencies": {
    "@microsoft/signalr": "^10.0.11",
    "@reflex/angular-components": "file:../../../packages/reflex-angular-components",
    "@reflex/shared-types": "file:../../../packages/reflex-shared-types",
    "d3": "^7.9.0",
    "express": "^5.1.0",
    "three": "^0.175.0"
  },
  "devDependencies": {
    "@types/d3": "^7.4.3",
    "@types/express": "^5.0.1",
    "@types/three": "^0.175.0",
    "@types/webxr": "^0.5.22"
  }
}
