{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "@reflex/angular-components": {
      "projectType": "library",
      "root": "packages/reflex-angular-components",
      "sourceRoot": "packages/reflex-angular-components/src",
      "prefix": "reflex",
      "architect": {
        "build": {
          "builder": "@angular/build:ng-packagr",
          "options": {
            "project": "packages/reflex-angular-components/ng-package.json"
          },
          "configurations": {
            "production": {
              "tsConfig": "packages/reflex-angular-components/tsconfig.lib.prod.json"
            },
            "development": {
              "tsConfig": "packages/reflex-angular-components/tsconfig.lib.json"
            }
          },
          "defaultConfiguration": "production"
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "tsConfig": "packages/reflex-angular-components/tsconfig.spec.json",
            "runner": "vitest",
            "buildTarget": "@reflex/angular-components:test-build",
            "runnerConfig": "packages/reflex-angular-components/vitest.config.mts",
            "reporters": [
              "default",
              [
                "junit",
                {
                  "outputFile": "test/artifacts/tests/junit-test-results-angular-components.xml"
                }
              ]
            ],
            "coverageReporters": [
              "html",
              [
                "text-summary",
                {
                  "file": "text-summary.txt"
                }
              ],
              "lcovonly",
              "cobertura"
            ],
            "browsers": [
              "chromium"
            ],
            "headless": true
          }
        },
        "test-build": {
          "builder": "@angular/build:application",
          "options": {
            "tsConfig": "packages/reflex-angular-components/tsconfig.spec.json",
            "polyfills": [],
            "styles": [
              "packages/reflex-angular-components/src/scss/reflex.scss"
            ],
            "outputPath": "dist/test-angular-components"
          }
        },
        "lint": {
          "builder": "@angular-eslint/builder:lint",
          "options": {
            "lintFilePatterns": [
              "packages/reflex-angular-components/**/*.{ts,tsx,mts,cts,js,cjs,mjs,html}"
            ],
            "maxWarnings": 0
          }
        }
      }
    },
    "TrackingServer": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:component": {
          "type": "component"
        },
        "@schematics/angular:directive": {
          "type": "directive"
        },
        "@schematics/angular:service": {
          "type": "service"
        },
        "@schematics/angular:guard": {
          "typeSeparator": "."
        },
        "@schematics/angular:interceptor": {
          "typeSeparator": "."
        },
        "@schematics/angular:module": {
          "typeSeparator": "."
        },
        "@schematics/angular:pipe": {
          "typeSeparator": "."
        },
        "@schematics/angular:resolver": {
          "typeSeparator": "."
        },
        "@schematics/angular:application": {
          "strict": true
        }
      },
      "root": "tools/ReFlex.TrackingServer/ClientApp",
      "sourceRoot": "tools/ReFlex.TrackingServer/ClientApp/src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "progress": false,
            "outputPath": {
              "base": "tools/ReFlex.TrackingServer/ClientApp/dist"
            },
            "index": "tools/ReFlex.TrackingServer/ClientApp/src/index.html",
            "polyfills": [
              "tools/ReFlex.TrackingServer/ClientApp/src/polyfills.ts"
            ],
            "tsConfig": "tools/ReFlex.TrackingServer/ClientApp/src/tsconfig.app.json",
            "assets": [
              "tools/ReFlex.TrackingServer/ClientApp/src/assets",
              {
                "glob": "**/*",
                "input": "node_modules/@reflex/angular-components/src/assets",
                "output": "assets"
              }
            ],
            "styles": [
              "tools/ReFlex.TrackingServer/ClientApp/src/sass/main.scss"
            ],
            "stylePreprocessorOptions": {
              "includePaths": [
                "tools/ReFlex.TrackingServer/ClientApp/src/sass",
                "node_modules/@reflex/angular-components/src/scss"
              ]
            },
            "scripts": [],
            "browser": "tools/ReFlex.TrackingServer/ClientApp/src/main.ts",
            "security": {
              "allowedHosts": []
            },
            "prerender": false,
            "ssr": false
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "500kb",
                  "maximumError": "2mb"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "6kb",
                  "maximumError": "100kb"
                }
              ],
              "fileReplacements": [
                {
                  "replace": "tools/ReFlex.TrackingServer/ClientApp/src/environments/environment.ts",
                  "with": "tools/ReFlex.TrackingServer/ClientApp/src/environments/environment.prod.ts"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": {
                "scripts": true,
                "hidden": false,
                "styles": true
              },
              "namedChunks": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "TrackingServer:build:production"
            },
            "development": {
              "proxyConfig": "tools/ReFlex.TrackingServer/ClientApp/proxy.conf.js",
              "buildTarget": "TrackingServer:build:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "extract-i18n": {
          "builder": "@angular/build:extract-i18n",
          "options": {
            "buildTarget": "TrackingServer:build"
          }
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "tsConfig": "tools/ReFlex.TrackingServer/ClientApp/src/tsconfig.spec.json",
            "runner": "vitest",
            "buildTarget": "TrackingServer:build:development",
            "runnerConfig": "tools/ReFlex.TrackingServer/ClientApp/vitest.config.mts",
            "reporters": [
              "default",
              [
                "junit",
                {
                  "outputFile": "test/artifacts/tests/junit-test-results.xml"
                }
              ]
            ],
            "coverageReporters": [
              "html",
              [
                "text-summary",
                {
                  "file": "text-summary.txt"
                }
              ],
              "lcovonly",
              "cobertura"
            ],
            "browsers": [
              "chromium"
            ],
            "headless": true
          }
        },
        "lint": {
          "builder": "@angular-eslint/builder:lint",
          "options": {
            "lintFilePatterns": [
              "tools/ReFlex.TrackingServer/ClientApp/**/*.{ts,tsx,mts,cts,js,cjs,mjs,html}"
            ],
            "maxWarnings": 0
          }
        }
      }
    },
